{
  "manifest_version": 3,
  "name": "Yoda Mail",
  "version": "1.1.1",
  "description": "Read your emails aloud in Yoda's voice, it will. An unofficial fan-made toy for Gmail.",
  "permissions": ["storage"],
  "host_permissions": ["https://mail.google.com/mail/*"],
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/mail/*"],
      "exclude_matches": ["https://mail.google.com/mail/*/h/*"],
      "js": [
        "src/util.js",
        "src/text.js",
        "src/speech.js",
        "src/watcher.js",
        "src/fab.js",
        "src/content.js"
      ],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/mascot.png"],
      "matches": ["https://mail.google.com/*"]
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
